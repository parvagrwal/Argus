# ==========================================
# TigerGraph Cloud (Savanna) Credentials
# ==========================================
TG_HOST=https://your-sentinel-subdomain.i.tgcloud.io
TG_GRAPHNAME=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_SECRET=your_generated_secret_key_here

# ==========================================
# LLM Configuration (Groq LPU)
# ==========================================
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# ==========================================
# Optional (defaults shown) - P1 graph access layer
# ==========================================
# REST++ and GSQL base paths on the TigerGraph Cloud 4.x (Savanna) host
TG_RESTPP_PATH=/restpp
TG_GSQL_PATH=/gsql
# HTTP timeout in seconds for graph calls
TG_TIMEOUT_S=60
# Set to 1 to force the offline mock backend (tests / no network). Mock results are never evidence.
ARGUS_FORCE_MOCK=0
